": 65, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "Супер!"}}, {"index": 66, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "Ой! Подивись ще раз."}}, {"index": 67, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "Майже! Ось правильна відповідь."}}, {"index": 68, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "Ого, яка серія!"}}, {"index": 69, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "Прочитай слово і знайди картинку."}}, {"index": 70, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "Дивись уважно, слово сховається!"}}, {"index": 71, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "Знайди літери по черзі, починаючи з А!"}}], [{"index": 72, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "А тепер подивимося, як ти читаєш українською!"}}, {"index": 73, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "А тепер вгадай: чиє це слово?"}}, {"index": 74, "params": {"model": "text2speech_v2", "variant": "elevenlabs", "voice_type": "preset", "voice_id": "3d1cdbad-25ef-5a04-93d9-b29be1b91299", "prompt": "Ця літера буває тільки в українській!"}}, {"index": 75, "params": {"mod